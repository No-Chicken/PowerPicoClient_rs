{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerPico Client",
  "version": "0.1.1",
  "identifier": "com.openfeasttech.powerpico-client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PowerPico Client",
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "PowerPico measurement and firmware client",
    "longDescription": "Open-source desktop client for capturing PowerPico measurements and flashing firmware.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
